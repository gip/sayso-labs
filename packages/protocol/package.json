{
  "name": "@sayso-labs/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "gen:types": "tsx scripts/generate-payload-types.ts",
    "prebuild": "pnpm run gen:types",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xmtp/content-type-primitives": "^3.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}

{
  "name": "@sayso-labs/example-finance",
  "version": "0.1.0",
  "description": "SaySo finance service agents, including the SaySo oracle spot price agent.",
  "type": "module",
  "private": true,
  "bin": {
    "sayso-finance-demo": "dist/cli/demo.js",
    "sayso-oracle": "dist/cli/oracle-agent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx src/test/run.ts",
    "sayso-demo": "node --import tsx src/cli/demo.ts",
    "sayso-oracle": "node --import tsx src/cli/oracle-agent.ts",
    "sayso-finance-demo": "node --import tsx src/cli/demo.ts"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",

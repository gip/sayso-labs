    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "quickjs-emscripten-core": "0.32.0",
    "viem": "^2.48.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
